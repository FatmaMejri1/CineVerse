rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ════════ USERS COLLECTION ════════
    match /users/{userId} {
      // Any authenticated user can read public user data; owner can update profile
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ── Subcollection: Favorites ──
      match /favorites/{favoriteId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }

      // ── Subcollection: Watchlist ──
      match /watchlist/{watchlistId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // ── Subcollection: Ratings ──
      match /ratings/{ratingId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId);
      }
    }

    // ════════ PUBLIC PROFILES & COMMENTS ════════
    match /publicProfiles/{userId} {
      // Public profiles are readable by all authenticated members for matching
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAdmin();

      // ── Subcollection: Comments & Discussions ──
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        // An authenticated member can post comments (authorUid must match requester)
        allow create: if isAuthenticated() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 500;
        // Comment author or profile owner can delete comments
        allow delete: if isAuthenticated() &&
          (resource.data.authorUid == request.auth.uid || isOwner(userId) || isAdmin());
        // Comments cannot be edited by third parties
        allow update: if isAuthenticated() &&
          resource.data.authorUid == request.auth.uid;
      }
    }

    // ════════ MOVIES (Admin / Catalog) ════════
    match /movies/{movieId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
